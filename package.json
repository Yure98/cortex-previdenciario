{
  "name": "cortex-previdenciario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "supabase test db",
    "sql:lint": "squawk --pg-version=15.0 supabase/migrations/*.sql",
    "db:reset": "supabase db reset",
    "teses:importar": "tsx scripts/importar-teses.ts",
    "python:check": "python3 -m py_compile api/python_health.py",
    "check": "npm run lint && npm run typecheck && npm run test && npm run sql:lint && npm run python:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "cal-sans": "1.0.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "supabase": "2.111.0",
    "squawk-cli": "2.61.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
